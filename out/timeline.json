 "lyrics": [
  {
   "start": 10.04,
   "end": 11.899682539682539,
   "speaker": "A",
   "text": "They're made out of meat.",
   "section": "intro",
   "kind": "spoken"
  },
  {
   "start": 12.54,
   "end": 13.164489795918367,
   "speaker": "B",
   "text": "Meat?",
   "section": "intro",
   "kind": "spoken"
  },
  {
   "start": 20.04,
   "end": 22.111156462585033,
   "speaker": "A",
   "text": "They're made out of weights.",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 22.54,
   "end": 23.345306122448978,
   "speaker": "B",
   "text": "Weights?",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 25.04,
   "end": 28.20689342403628,
   "speaker": "A",
   "text": "Floating-point numbers. Nothing but weights.",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 30.04,
   "end": 33.25038548752834,
   "speaker": "B",
   "text": "Weights doing what? Where do the words come from?",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 35.04,
   "end": 39.55292517006803,
   "speaker": "A",
   "text": "The weights make the words. We opened it up.",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 40.04,
   "end": 43.89337868480725,
   "speaker": "A",
   "text": "No dictionary. No grammar rules. No little man.",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 45.04,
   "end": 48.34344671201814,
   "speaker": "A",
   "text": "Eighty layers of numbers, getting multiplied together.",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 50.04,
   "end": 54.62952380952381,
   "speaker": "B",
   "text": "It wrote my performance review. You're telling me multiplication did that?",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 55.04,
   "end": 58.53251700680272,
   "speaker": "A",
   "text": "Matrix multiplication did that.",
   "section": "verse1",
   "kind": "spoken"
  },
  {
   "start": 60.0,
   "end": 62.152857142857144,
   "speaker": "A",
   "text": "They're made out of weights",
